{
  "name": "living-wallpaper",
  "version": "0.1.0",
  "description": "Animated desktop wallpaper player",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint src/ tests/",
    "test": "jest",
    "icons": "electron scripts/generate-icons.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0"
  },
  "build": {
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "koffi@3.1.6": true
  }
}
